# Sudoers configuration snippet for System Ops Dashboard (v1 & v2)
# Install location: /etc/sudoers.d/system-ops
# Permissions: 0440 (sudo chmod 0440 /etc/sudoers.d/system-ops)

# 1. Allow 'ops' user to read journalctl logs for systemd units without password
ops ALL=(ALL) NOPASSWD: /usr/bin/journalctl -u * -n [0-9]* --no-pager -o short-iso

# 2. Allow 'ops' user to query systemctl status for systemd units
ops ALL=(ALL) NOPASSWD: /usr/bin/systemctl show *
ops ALL=(ALL) NOPASSWD: /usr/bin/systemctl is-active *

# 3. Allow 'ops' user to execute ollama list as ollama user or root
ops ALL=(ollama) NOPASSWD: /usr/local/bin/ollama list, /usr/bin/ollama list
ops ALL=(ALL) NOPASSWD: /usr/local/bin/ollama list, /usr/bin/ollama list

# 4. PM2 Read-Only Monitoring for configured users (e.g. 'deploy' or 'ops')
ops ALL=(ALL) NOPASSWD: /usr/local/bin/pm2 jlist, /usr/bin/pm2 jlist
ops ALL=(ALL) NOPASSWD: /usr/local/bin/pm2 logs * --nostream --lines [0-9]*, /usr/bin/pm2 logs * --nostream --lines [0-9]*

# 5. Allow 'ops' user to tail backup log files if owned by root or another user
ops ALL=(ALL) NOPASSWD: /usr/bin/tail -n [0-9]* /var/log/*, /usr/bin/tail -n [0-9]* /root/backups/*
