# Sudoers configuration snippet for System Ops Dashboard
# Install location: /etc/sudoers.d/system-ops
# Permissions: 0440 (sudo chmod 0440 /etc/sudoers.d/system-ops)

# Allow 'ops' user to read journalctl logs for ollama.service without password prompt
ops ALL=(ALL) NOPASSWD: /usr/bin/journalctl -u ollama -n [0-9]* --no-pager -o short-iso

# Allow 'ops' user to query systemctl status for ollama.service
ops ALL=(ALL) NOPASSWD: /usr/bin/systemctl show ollama *
ops ALL=(ALL) NOPASSWD: /usr/bin/systemctl is-active ollama

# Allow 'ops' user to execute ollama list as ollama user
ops ALL=(ALL) NOPASSWD: /usr/bin/sudo -u ollama -H /usr/local/bin/ollama list, /usr/bin/sudo -u ollama -H /usr/bin/ollama list
