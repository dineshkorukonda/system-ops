[Unit]
Description=System Ops self-hosted operations console
After=network.target

[Service]
Type=simple
User=ops
Group=ops
WorkingDirectory=/opt/system-ops
ExecStart=/usr/bin/node /opt/system-ops/src/start.js
Restart=always
RestartSec=5s

# Security Hardening & Resource Caps
EnvironmentFile=/opt/system-ops/.env
Environment=NODE_ENV=production
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
NoNewPrivileges=false

# Memory cap to prevent runaway usage on 8GB VPS
MemoryMax=512M
MemoryHigh=400M

[Install]
WantedBy=multi-user.target
