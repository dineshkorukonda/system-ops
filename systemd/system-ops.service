[Unit]
Description=System Ops Dashboard (Subdomain Ops Mini-Site)
After=network.target system-ops-collector.service
Wants=system-ops-collector.service

[Service]
Type=simple
User=ops
Group=ops
WorkingDirectory=/opt/system-ops
ExecStart=/usr/bin/node /opt/system-ops/src/start.js
Restart=always
RestartSec=5s

# Security Hardening & Resource Caps
EnvironmentFile=/opt/system-ops/.env
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
NoNewPrivileges=false

# Memory cap to prevent runaway usage on 8GB VPS
MemoryMax=512M
MemoryHigh=400M

[Install]
WantedBy=multi-user.target
