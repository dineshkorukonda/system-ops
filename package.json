{
  "name": "system-ops",
  "version": "2.1.0",
  "description": "Self-hosted Ubuntu operations console with optional integrations and bounded telemetry",
  "main": "src/start.js",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "vite build --config config/vite.config.mjs",
    "start": "node src/start.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "test:smoke": "node scripts/runtime-smoke.js",
    "typecheck": "tsc -p config/tsconfig.collectors.json",
    "test:ui": "playwright test -c config/playwright.config.cjs",
    "docs:build": "node scripts/build-site.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "site:dev": "node scripts/serve-site.mjs",
    "test:site": "playwright test -c config/playwright.site.config.cjs",
    "licenses:report": "node scripts/license-report.mjs",
    "release:pack": "node scripts/package-release.mjs"
  },
  "keywords": [
    "nodejs",
    "express",
    "devops",
    "vps-monitoring",
    "pm2",
    "nginx",
    "self-hosted",
    "docker",
    "ollama",
    "systemd",
    "grafana-alternative"
  ],
  "author": "Dinesh Korukonda",
  "private": true,
  "homepage": "https://system-ops.dineshkorukonda.online/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dineshkorukonda/system-ops.git"
  },
  "bugs": {
    "url": "https://github.com/dineshkorukonda/system-ops/issues"
  },
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "geoip-lite": "^2.0.3",
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "ua-parser-js": "^1.0.41"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "marked": "^18.1.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
