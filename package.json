{
  "name": "system-ops",
  "version": "2.0.0",
  "description": "Fast, lightweight (<35MB RAM) operations console for single Ubuntu VPS - Ollama, PM2, system health, Postgres backups, and GeoIP traffic analytics",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "devops",
    "vps-monitoring",
    "pm2",
    "nginx",
    "self-hosted",
    "docker",
    "ollama",
    "systemd",
    "grafana-alternative"
  ],
  "author": "Antigravity AI",
  "license": "MIT",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "geoip-lite": "^2.0.3",
    "ua-parser-js": "^2.0.10"
  }
}
