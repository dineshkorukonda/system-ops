# System Ops Mini-Site Environment Configuration (v1 & v2)

# Server Binding (Loopback recommended, Nginx reverse-proxies to this port)
PORT=9080
HOST=127.0.0.1

# Optional Go collector sidecar (Linux production — auto-used when healthy)
# ENABLE_GO_COLLECTOR=true
# GO_COLLECTOR_URL=http://127.0.0.1:9081
# GO_COLLECTOR_PORT=9081
# GO_COLLECTOR_HOST=127.0.0.1
# GO_COLLECTOR_TIMEOUT_MS=2000

# Ollama (only shown in dashboard when detected or ENABLE_OLLAMA=true)
# ENABLE_OLLAMA=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_SERVICE_NAME=ollama

# Authentication & Security Settings
# Change APP_PASSWORD to a strong secret before deploying!
APP_PASSWORD=admin-password-change-me
SESSION_SECRET=super-secret-session-key-change-me

# Dashboard Settings
# Optional: seed site name before first settings.json is created
SITE_NAME=system-ops
SITE_SUBTITLE=Operations Console
DEFAULT_LOG_LINES=100
MAX_LOG_LINES=500
AUTO_REFRESH_SECONDS=30
ENABLE_CHAT_TEST=true

# Docker Configuration
# DOCKER_PATH=/usr/bin/docker
# DOCKER_SOCKET=/var/run/docker.sock
# DOCKER_USE_SUDO=true

# Monitoring Collectors (leave empty to auto-detect only what exists on the host)
# PM2_USERS=root
DISK_PATHS=/,/var
SYSTEMD_UNITS=system-ops
TLS_HOSTS=
LOG_SOURCES=
BACKUPS_DIR=
NGINX_LOG_PATH=/var/log/nginx/access.log
# Leave TRACKED_DOMAINS empty to auto-discover all Nginx and Docker domains automatically
TRACKED_DOMAINS=

# Database health probes (auto-detected when ports are open)
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# MYSQL_PORT=3306

# Rate Limiting Settings (Requests per 15-minute window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=3000
CHAT_TEST_RATE_LIMIT_MAX=30
LOG_TAIL_RATE_LIMIT_MAX=300

# Update Settings
# GitHub repo for version checks (owner/repo format)
GITHUB_REPO=dineshkorukonda/system-ops
GITHUB_BRANCH=main
