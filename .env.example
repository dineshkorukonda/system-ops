# Ollama Ops Mini-Site Environment Configuration

# Server Binding (Loopback recommended, Nginx reverse-proxies to this port)
PORT=9080
HOST=127.0.0.1

# Ollama Endpoint Configuration
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_SERVICE_NAME=ollama

# Dashboard Settings
DEFAULT_LOG_LINES=100
MAX_LOG_LINES=500
AUTO_REFRESH_INTERVAL=30
ENABLE_CHAT_TEST=true

# Authentication & Security Settings
# Change APP_PASSWORD to a strong secret before deploying!
APP_PASSWORD=admin-password-change-me
SESSION_SECRET=super-secret-session-key-change-me

# Rate Limiting Settings (Requests per window)
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=300
CHAT_TEST_RATE_LIMIT_MAX=10  # Max 10 chat tests per 15 minutes per IP
