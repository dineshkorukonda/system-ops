# System Ops Mini-Site Environment Configuration (v1 & v2)

# Server Binding (Loopback recommended, Nginx reverse-proxies to this port)
PORT=9080
HOST=127.0.0.1

# Ollama Endpoint Configuration (v1)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_SERVICE_NAME=ollama

# Authentication & Security Settings
# Change APP_PASSWORD to a strong secret before deploying!
APP_PASSWORD=admin-password-change-me
SESSION_SECRET=super-secret-session-key-change-me

# Dashboard Settings
DEFAULT_LOG_LINES=100
MAX_LOG_LINES=500
AUTO_REFRESH_SECONDS=30
ENABLE_CHAT_TEST=true

# v2 Monitoring Collectors Configuration
PM2_USERS=deploy
DISK_PATHS=/,/var,/root/backups
SYSTEMD_UNITS=nginx,ollama,system-ops,postgresql
TLS_HOSTS=system-health.iskconcommunity
LOG_SOURCES=pg-backup:/var/log/pg-backup.log:200,journal:postgresql:100

# Rate Limiting Settings (Requests per 15-minute window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
CHAT_TEST_RATE_LIMIT_MAX=10
LOG_TAIL_RATE_LIMIT_MAX=30
