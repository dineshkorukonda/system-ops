# Copy to .env.docker and adjust before: docker compose --env-file .env.docker up -d

APP_PASSWORD=change_me_in_production
SESSION_SECRET=random_secret_token_ops_2026

PORT=9080
HOST=0.0.0.0
NODE_ENV=production

# Host bind mounts in docker-compose.yml expose these paths inside the container.
SYSTEMD_UNITS=nginx,ollama,postgresql
DISK_PATHS=/,/var
TLS_HOSTS=
NGINX_LOG_PATH=/var/log/nginx/access.log
TRACKED_DOMAINS=
LOG_SOURCES=
BACKUPS_DIR=

OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_SERVICE_NAME=ollama

# Docker monitoring: mount socket in compose (see security warning) or add ops to docker group on host.
# DOCKER_USE_SUDO=true

# Go sidecar is not started inside the default container — host metrics use Node collectors only.
ENABLE_GO_COLLECTOR=false
ENABLE_SYSTEM_COLLECTOR=false
