# Copy to .env.docker and adjust before: docker compose --env-file .env.docker up -d

# Required: set your own password and a random secret (at least 32 bytes).
# Generate SESSION_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_PASSWORD=
SESSION_SECRET=

PORT=9080
HOST=0.0.0.0
NODE_ENV=production

# Paths below refer to the container. Host systemd is not available in this image.
SYSTEMD_UNITS=
DISK_PATHS=/,/var
TLS_HOSTS=
NGINX_LOG_PATH=/var/log/nginx/access.log
TRACKED_DOMAINS=
LOG_SOURCES=
BACKUPS_DIR=

OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_SERVICE_NAME=ollama

# Docker monitoring: mount socket in compose (see security warning) or add ops to docker group on host.
# DOCKER_USE_SUDO=true

# Go sidecar is not started in this image. Node samples the container's /proc;
# /host/proc and /host/sys mounts do not enable host CPU/process sampling.
ENABLE_GO_COLLECTOR=false
